# No quotes around the values: `docker run --env-file` would keep them.
# The SQLite file. In compose, it lives in a volume: file:/app/db/salle.db
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-secret-change-me-in-production
PORT=3000
# Where the frontend runs: the only origin allowed to call this API from a browser
WEB_ORIGIN=http://localhost:5173
# Only the addresses of this domain can register
SCHOOL_EMAIL_DOMAIN=castelmont.fr
